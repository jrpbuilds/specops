{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://specops.dev/schemas/specops.schema.json",
    "title": "Final SpecOps configuration",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "openspec",
        "workflow",
        "routing",
        "automation",
        "escalation",
        "review",
        "integrations"
    ],
    "properties": {
        "version": { "const": 1 },
        "openspec": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
                "command": {
                    "oneOf": [
                        { "type": "null" },
                        {
                            "type": "array",
                            "minItems": 1,
                            "items": { "type": "string", "minLength": 1 }
                        }
                    ]
                }
            }
        },
        "workflow": {
            "type": "object",
            "additionalProperties": false,
            "required": ["defaultTier", "onboarding", "scopeThresholds"],
            "properties": {
                "defaultTier": { "enum": ["auto", "lean", "standard", "full"] },
                "onboarding": { "enum": ["if-missing", "always"] },
                "scopeThresholds": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "leanMaxFiles",
                        "leanMaxModules",
                        "fullMinFiles",
                        "fullMinModules"
                    ],
                    "properties": {
                        "leanMaxFiles": { "type": "integer", "minimum": 1 },
                        "leanMaxModules": { "type": "integer", "minimum": 1 },
                        "fullMinFiles": { "type": "integer", "minimum": 2 },
                        "fullMinModules": { "type": "integer", "minimum": 2 }
                    }
                }
            }
        },
        "routing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["forceFullForFacets"],
            "properties": {
                "forceFullForFacets": {
                    "type": "array",
                    "items": {
                        "enum": [
                            "security",
                            "data",
                            "public-contract",
                            "concurrency",
                            "resilience",
                            "performance",
                            "infrastructure",
                            "migration",
                            "usability",
                            "maintainability"
                        ]
                    }
                }
            }
        },
        "automation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requireCleanWorktree"],
            "properties": { "requireCleanWorktree": { "type": "boolean" } }
        },
        "escalation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["budgets"],
            "properties": {
                "budgets": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "maxScopeEscalations",
                        "maxSpecialistDispatches",
                        "maxRepairCycles",
                        "maxRepeatedFailureFingerprints"
                    ],
                    "properties": {
                        "maxScopeEscalations": { "type": "integer", "minimum": 0 },
                        "maxSpecialistDispatches": { "type": "integer", "minimum": 0 },
                        "maxRepairCycles": { "type": "integer", "minimum": 0 },
                        "maxRepeatedFailureFingerprints": { "type": "integer", "minimum": 0 }
                    }
                }
            }
        },
        "frontier": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mode",
                "maxEscalationsPerRun",
                "maxDispatchesPerRun",
                "maxHighDispatchesPerRun"
            ],
            "properties": {
                "mode": { "enum": ["disabled", "adaptive"] },
                "maxEscalationsPerRun": { "type": "integer", "minimum": 0 },
                "maxDispatchesPerRun": { "type": "integer", "minimum": 0 },
                "maxHighDispatchesPerRun": { "type": "integer", "minimum": 0 }
            }
        },
        "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "blockingSeverities",
                "maxDiffBytes",
                "maxContextBytes",
                "transientRetries",
                "agentTimeoutSeconds",
                "commandTimeoutSeconds",
                "commandOutputBytes"
            ],
            "properties": {
                "blockingSeverities": {
                    "type": "array",
                    "items": { "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"] }
                },
                "maxDiffBytes": { "type": "integer", "minimum": 1000 },
                "maxContextBytes": { "type": "integer", "minimum": 1000 },
                "transientRetries": { "type": "integer", "minimum": 0 },
                "agentTimeoutSeconds": { "type": "integer", "minimum": 30 },
                "commandTimeoutSeconds": { "type": "integer", "minimum": 1 },
                "commandOutputBytes": { "type": "integer", "minimum": 1024 }
            }
        },
        "integrations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mcp"],
            "properties": { "mcp": { "enum": ["inherit", "disabled"] } }
        }
    }
}
