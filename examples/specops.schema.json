{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specops.dev/schemas/specops.schema.json",
  "title": "SpecOps project configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "openspec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "required": ["command", "schema"]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_tier": {
          "enum": ["auto", "lean", "standard", "full"]
        },
        "onboarding": {
          "enum": ["if-missing", "always"]
        },
        "lean_max_files": {
          "type": "integer",
          "minimum": 1
        },
        "lean_max_modules": {
          "type": "integer",
          "minimum": 1
        },
        "full_min_files": {
          "type": "integer",
          "minimum": 2
        },
        "full_min_modules": {
          "type": "integer",
          "minimum": 2
        }
      },
      "required": [
        "default_tier",
        "onboarding",
        "lean_max_files",
        "lean_max_modules",
        "full_min_files",
        "full_min_modules"
      ]
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_fix_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "require_clean_worktree": {
          "type": "boolean"
        },
        "blocking_severities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"]
          }
        }
      },
      "required": ["max_fix_cycles", "require_clean_worktree", "blocking_severities"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_diff_bytes": {
          "type": "integer",
          "minimum": 1000
        },
        "transient_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "agent_timeout_seconds": {
          "type": "integer",
          "minimum": 30
        }
      },
      "required": ["max_diff_bytes", "transient_retries", "agent_timeout_seconds"]
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "enum": ["inherit", "disabled"]
        }
      },
      "required": ["mcp"]
    }
  },
  "required": ["openspec", "workflow", "automation", "review", "integrations"]
}
