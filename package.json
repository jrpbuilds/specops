{
    "name": "@jrpbuilds/specops",
    "version": "0.16.2",
    "description": "Spec-driven development orchestration plugin for OpenCode, powered by OpenSpec.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./tui": {
            "import": "./dist/tui.js",
            "types": "./dist/tui.d.ts"
        }
    },
    "files": [
        "dist",
        "prompts",
        "examples",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "generate": "npm run build && npm run format",
        "build": "node scripts/clean.mjs && tsc",
        "clean:specops": "node scripts/clean-specops-cache.mjs",
        "prepublishOnly": "npm run build",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "test:packed": "npm run build && node scripts/test-packed-install.mjs",
        "smoke:opencode": "npm run build && SPECOPS_OPENCODE_SMOKE=1 node scripts/test-packed-install.mjs",
        "onboard": "node scripts/onboard.mjs",
        "test:openspec:compat": "npx --yes @fission-ai/openspec@1.7.0 schemas --json && npx --yes @fission-ai/openspec@1.7.0 validate rewrite-specops-1-0 --strict",
        "docs:check": "node scripts/check-doc-links.mjs && node scripts/check-compatibility.mjs",
        "deadcode:check": "knip",
        "check": "npm run format:check && npm run typecheck && npm run deadcode:check && npm run test && npm run test:packed && npm run test:openspec:compat && npm run docs:check"
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "spec-driven-development",
        "openspec",
        "specops",
        "ai",
        "llm",
        "orchestration",
        "workflow"
    ],
    "author": "jrpbuilds",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jrpbuilds/specops.git"
    },
    "bugs": {
        "url": "https://github.com/jrpbuilds/specops/issues"
    },
    "homepage": "https://github.com/jrpbuilds/specops#readme",
    "engines": {
        "node": ">=24.18.1"
    },
    "knip": {
        "ignore": [
            "site/**"
        ]
    },
    "dependencies": {
        "@fission-ai/openspec": "1.7.0"
    },
    "peerDependencies": {
        "@opencode-ai/plugin": ">=1.18.10"
    },
    "devDependencies": {
        "@opencode-ai/plugin": "1.18.10",
        "@types/node": "^24.0.0",
        "knip": "^6.29.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.0",
        "vitest": "^3.2.0"
    }
}
